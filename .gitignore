# ─────────────────────────────────────────────────────────────────────────
# Build artifacts — regenerated by the scripts, never committed
# ─────────────────────────────────────────────────────────────────────────
.build/
.src/

# ─────────────────────────────────────────────────────────────────────────
# Toolchain binaries — distributed via GitHub Releases, kept out of git.
# To populate web/assets/: run scripts/build-toolchain.sh OR download the
# Release and extract here. web/assets/README.md and manifest.json stay
# tracked (the folder persists and the manifest pins the expected
# version/sha256).
# ─────────────────────────────────────────────────────────────────────────
web/assets/*.wasm
web/assets/*.tar
web/assets/*.br
web/assets/*.gz

# ─────────────────────────────────────────────────────────────────────────
# Editor / OS cruft
# ─────────────────────────────────────────────────────────────────────────
*.log
*.swp
*.tmp
.DS_Store
Thumbs.db

# Redundant image format (not rendered by GitHub) — keep example.png
*.jxl
